{
  "name": "dbot-k2j-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord Korean-to-Japanese voice translation bot",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.26.5",
    "prism-media": "^1.3.5",
    "sodium-native": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@discordjs/opus@0.10.0": true
  },
  "overrides": {
    "undici": "^6.27.0",
    "tar": "^7.5.20"
  }
}
