# ============================================================
# dbot-k2j 設定 (このファイルを .env にコピーして編集してください)
#   cp .env.example .env
# ============================================================

# --- Discord (必須) ---
# Discord Developer Portal → Bot → Reset Token で取得
DISCORD_TOKEN=

# --- 翻訳エンジン: deepl | anthropic ---
MT_PROVIDER=deepl

# DeepL API キー (https://www.deepl.com/ja/pro-api で無料登録。無料枠 50万文字/月)
# 無料プランのキーは末尾が ":fx" (自動でエンドポイントを判別します)
DEEPL_API_KEY=

# Anthropic API キー (https://platform.claude.com で発行)
ANTHROPIC_API_KEY=
# 翻訳に使う Claude モデル。低遅延・低コスト重視の既定値。
# 品質を上げたい場合は claude-opus-4-8 などに変更可
ANTHROPIC_MODEL=claude-haiku-4-5

# --- 音声認識 (STT): ローカル / OpenAI を base URL で切替 ---
# ローカル (speaches コンテナ) を使う場合 (既定):
STT_BASE_URL=http://stt:8000/v1
STT_API_KEY=
STT_MODEL=Systran/faster-whisper-small
# OpenAI を使う場合は上 3 行を以下に変更:
#   STT_BASE_URL=https://api.openai.com/v1
#   STT_API_KEY=sk-...
#   STT_MODEL=gpt-4o-mini-transcribe
# 認識言語 ("ko" 固定を推奨。"auto" で自動判定)
STT_LANGUAGE=ko

# --- 読み上げ (TTS: VOICEVOX) ---
# 既定の読み上げ ON/OFF (サーバ毎に /k2j tts で上書き可)
TTS_ENABLED=true
# 話者 ID (3 = ずんだもん ノーマル。一覧: docker compose exec voicevox curl -s localhost:50021/speakers)
VOICEVOX_SPEAKER=3

# --- Docker Compose ---
# ローカル STT コンテナを起動するプロファイル。OpenAI STT のみ使うなら空にする
COMPOSE_PROFILES=local-stt

# --- チューニング (通常は変更不要) ---
# 発話区切りとみなす無音時間 (ms)
#SILENCE_MS=800
# これ未満の発話は破棄 (ms)
#MIN_UTTERANCE_MS=400
# 1 発話の上限 (ms)。超えたら区切って処理
#MAX_UTTERANCE_MS=30000
# 音量ゲート (int16 RMS)。環境ノイズだけの区間を破棄
#RMS_THRESHOLD=250
# STT の同時実行数
#STT_CONCURRENCY=2
# 読み上げに回す訳文の最大文字数 (超過分は切り詰め。字幕は常に全文)
#TTS_MAX_CHARS=300
# 読み上げキューの滞留上限 (ms)。超えた分はスキップ (字幕は投稿済み)
#TTS_MAX_QUEUE_AGE_MS=15000
